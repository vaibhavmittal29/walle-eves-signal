{
  "name": "changewatch",
  "version": "1.0.0",
  "description": "ChangeWatch — Intelligent Website Change Detector",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/server.ts",
    "build": "vite build && esbuild src/server/server.ts --platform=node --target=node20 --format=esm --packages=external --bundle --outfile=dist/server.js",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "benchmark": "tsx scripts/benchmark-200.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cheerio": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "diff": "^7.0.0",
    "express": "^4.21.2",
    "ipaddr.js": "^2.2.0",
    "nodemailer": "^6.10.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.50.1",
    "pngjs": "^7.0.0",
    "robots-parser": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/diff": "^7.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "lucide-react": "^0.475.0",
    "postcss": "^8.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
